# ==============================================================================
# EDUEME RESEARCH LABS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3005

# ------------------------------------------------------------------------------
# SUPABASE CLOUD DATABASE CONFIGURATION (OPTIONAL)
# When you obtain your Supabase API keys, fill them in below.
# The server will automatically connect to Supabase Cloud PostgreSQL!
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-service-role-api-key

# Notification & Alert Settings
ADMIN_ALERT_WHATSAPP=+919876543210
ADMIN_ALERT_EMAIL=admin@edueme.com
